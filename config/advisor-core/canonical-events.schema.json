{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nourhelmi/pi-meta-harness/config/advisor-core/canonical-events.schema.json",
  "title": "Advisor canonical event (v1)",
  "description": "One line of an advisor run trace. Hosts (Pi, Claude Code, Codex) translate native lifecycle into these events; surfaces (Herdr, BB, CLI) render them. See docs/advisor-protocol.md for ordering rules the schema cannot express.",
  "type": "object",
  "required": ["v", "seq", "at", "run", "node", "parent", "host", "type", "data"],
  "additionalProperties": false,
  "properties": {
    "v": { "const": 1, "description": "Trace protocol version." },
    "seq": { "type": "integer", "minimum": 1, "description": "Monotonic per run, contiguous from 1." },
    "at": { "type": "string", "format": "date-time", "description": "ISO-8601 UTC timestamp; non-decreasing within a run." },
    "run": { "$ref": "#/$defs/id", "description": "Logical advisor run id (one graph execution or one single-worker launch)." },
    "node": {
      "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }],
      "description": "Node the event is about. Null only for run-level events. For parent.awakened this is the parent node."
    },
    "parent": {
      "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }],
      "description": "Logical parent of `node` (the advisor root or a foreman). Null for the root node and run-level events."
    },
    "host": { "$ref": "#/$defs/host", "description": "Execution host that emitted the event." },
    "type": {
      "enum": [
        "run.created",
        "graph.planned",
        "wave.started",
        "wave.completed",
        "node.launched",
        "node.progress",
        "node.blocked",
        "node.reply.sent",
        "node.cancel.requested",
        "node.resumed",
        "node.result.written",
        "node.result.validated",
        "node.settled",
        "parent.awakened"
      ]
    },
    "data": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "run.created" } } },
      "then": { "properties": { "node": { "type": "null" }, "parent": { "type": "null" }, "data": { "$ref": "#/$defs/run.created" } } }
    },
    {
      "if": { "properties": { "type": { "const": "graph.planned" } } },
      "then": { "properties": { "node": { "type": "null" }, "parent": { "type": "null" }, "data": { "$ref": "#/$defs/graph.planned" } } }
    },
    {
      "if": { "properties": { "type": { "const": "wave.started" } } },
      "then": { "properties": { "node": { "type": "null" }, "parent": { "type": "null" }, "data": { "$ref": "#/$defs/wave.started" } } }
    },
    {
      "if": { "properties": { "type": { "const": "wave.completed" } } },
      "then": { "properties": { "node": { "type": "null" }, "parent": { "type": "null" }, "data": { "$ref": "#/$defs/wave.completed" } } }
    },
    {
      "if": { "properties": { "type": { "const": "node.launched" } } },
      "then": { "properties": { "node": { "$ref": "#/$defs/id" }, "parent": { "$ref": "#/$defs/id" }, "data": { "$ref": "#/$defs/node.launched" } } }
    },
    {
      "if": { "properties": { "type": { "const": "node.progress" } } },
      "then": { "properties": { "node": { "$ref": "#/$defs/id" }, "parent": { "$ref": "#/$defs/id" }, "data": { "$ref": "#/$defs/node.progress" } } }
    },
    {
      "if": { "properties": { "type": { "const": "node.blocked" } } },
      "then": { "properties": { "node": { "$ref": "#/$defs/id" }, "parent": { "$ref": "#/$defs/id" }, "data": { "$ref": "#/$defs/node.blocked" } } }
    },
    {
      "if": { "properties": { "type": { "const": "node.reply.sent" } } },
      "then": { "properties": { "node": { "$ref": "#/$defs/id" }, "parent": { "$ref": "#/$defs/id" }, "data": { "$ref": "#/$defs/node.reply.sent" } } }
    },
    {
      "if": { "properties": { "type": { "const": "node.cancel.requested" } } },
      "then": { "properties": { "node": { "$ref": "#/$defs/id" }, "parent": { "$ref": "#/$defs/id" }, "data": { "$ref": "#/$defs/node.cancel.requested" } } }
    },
    {
      "if": { "properties": { "type": { "const": "node.resumed" } } },
      "then": { "properties": { "node": { "$ref": "#/$defs/id" }, "parent": { "$ref": "#/$defs/id" }, "data": { "$ref": "#/$defs/node.resumed" } } }
    },
    {
      "if": { "properties": { "type": { "const": "node.result.written" } } },
      "then": { "properties": { "node": { "$ref": "#/$defs/id" }, "parent": { "$ref": "#/$defs/id" }, "data": { "$ref": "#/$defs/node.result.written" } } }
    },
    {
      "if": { "properties": { "type": { "const": "node.result.validated" } } },
      "then": { "properties": { "node": { "$ref": "#/$defs/id" }, "parent": { "$ref": "#/$defs/id" }, "data": { "$ref": "#/$defs/node.result.validated" } } }
    },
    {
      "if": { "properties": { "type": { "const": "node.settled" } } },
      "then": { "properties": { "node": { "$ref": "#/$defs/id" }, "parent": { "$ref": "#/$defs/id" }, "data": { "$ref": "#/$defs/node.settled" } } }
    },
    {
      "if": { "properties": { "type": { "const": "parent.awakened" } } },
      "then": { "properties": { "node": { "$ref": "#/$defs/id" }, "data": { "$ref": "#/$defs/parent.awakened" } } }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "host": { "enum": ["pi", "claude-code", "codex"] },
    "harness": { "enum": ["pi", "codex", "claude-code"] },
    "riskTier": { "enum": ["low", "standard", "high"] },
    "settledStatus": {
      "enum": ["done", "blocked", "failed", "stalled", "cancelled"],
      "description": "done and blocked require a prior valid node.result.validated; failed, stalled, and cancelled do not."
    },
    "blockedKind": { "enum": ["question", "decision", "permission", "credential", "external-action"] },
    "run.created": {
      "type": "object",
      "required": ["workstream", "root"],
      "additionalProperties": false,
      "properties": {
        "workstream": { "type": "string", "minLength": 1 },
        "goal": { "type": "string" },
        "graph": { "$ref": "#/$defs/id", "description": "Graph manifest id when the run executes a validated graph." },
        "stateRoot": { "type": "string", "description": "Advisor state root the run writes under." },
        "root": {
          "type": "object",
          "required": ["node", "session"],
          "additionalProperties": false,
          "properties": {
            "node": { "$ref": "#/$defs/id", "description": "Id of the root (advisor) node; the logical parent of top-level workers." },
            "session": { "type": "string", "minLength": 1, "description": "Host session identity of the root advisor." }
          }
        }
      }
    },
    "graph.planned": {
      "type": "object",
      "required": ["graph", "waves", "maxParallel", "maxRepairLoops"],
      "additionalProperties": false,
      "properties": {
        "graph": { "$ref": "#/$defs/id" },
        "waves": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/id" }
          }
        },
        "maxParallel": { "type": "integer", "minimum": 1 },
        "maxRepairLoops": { "type": "integer", "minimum": 0 }
      }
    },
    "wave": {
      "type": "object",
      "required": ["wave", "nodes"],
      "additionalProperties": false,
      "properties": {
        "wave": { "type": "integer", "minimum": 1 },
        "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "wave.started": { "$ref": "#/$defs/wave" },
    "wave.completed": { "$ref": "#/$defs/wave" },
    "node.launched": {
      "type": "object",
      "required": ["role", "label", "harness", "model", "thinking", "cwd", "riskTier", "acceptance"],
      "additionalProperties": false,
      "properties": {
        "role": { "type": "string", "minLength": 1, "description": "Configured semantic role, or `freeform`." },
        "label": { "type": "string", "minLength": 1 },
        "harness": { "$ref": "#/$defs/harness" },
        "model": { "type": "string", "minLength": 1 },
        "thinking": { "type": "string", "minLength": 1 },
        "cwd": { "type": "string", "minLength": 1 },
        "riskTier": { "$ref": "#/$defs/riskTier" },
        "acceptance": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "resultPath": { "type": "string", "description": "Durable result artifact path when reserved before launch." },
        "keepAlive": { "type": "boolean" },
        "launchRef": {
          "type": "object",
          "description": "Host-native identifiers (pi-detach run id, Herdr pane, agent name, native task id). Opaque to surfaces.",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "node.progress": {
      "type": "object",
      "required": ["note"],
      "additionalProperties": false,
      "properties": { "note": { "type": "string", "minLength": 1 } }
    },
    "node.blocked": {
      "type": "object",
      "required": ["request"],
      "additionalProperties": false,
      "properties": {
        "request": {
          "type": "object",
          "required": ["kind", "text"],
          "additionalProperties": false,
          "properties": {
            "kind": { "$ref": "#/$defs/blockedKind" },
            "text": { "type": "string", "minLength": 1 },
            "options": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        }
      }
    },
    "node.reply.sent": {
      "type": "object",
      "required": ["text", "source"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "source": { "enum": ["advisor", "user"] },
        "replyTo": { "type": "integer", "minimum": 1 }
      }
    },
    "node.cancel.requested": {
      "type": "object",
      "required": ["reason"],
      "additionalProperties": false,
      "properties": { "reason": { "type": "string", "minLength": 1 } }
    },
    "node.resumed": {
      "type": "object",
      "required": ["reason"],
      "additionalProperties": false,
      "properties": { "reason": { "enum": ["reply", "restart", "follow-up"] } }
    },
    "node.result.written": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "node.result.validated": {
      "type": "object",
      "required": ["path", "valid", "problems"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "valid": { "type": "boolean" },
        "problems": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "status": { "type": "string", "minLength": 1, "description": "First line under the result's Status heading, when valid." }
      }
    },
    "node.settled": {
      "type": "object",
      "required": ["status", "reason"],
      "additionalProperties": false,
      "properties": {
        "status": { "$ref": "#/$defs/settledStatus" },
        "reason": { "type": "string", "minLength": 1 },
        "resultStatus": { "type": "string", "minLength": 1 },
        "surfaceClosed": { "type": "boolean", "description": "Whether the host closed the worker's visible surface on settlement." }
      }
    },
    "parent.awakened": {
      "type": "object",
      "required": ["child", "childStatus", "wakeGeneration"],
      "additionalProperties": false,
      "properties": {
        "child": { "$ref": "#/$defs/id" },
        "childStatus": { "$ref": "#/$defs/settledStatus" },
        "wakeGeneration": { "type": "integer", "minimum": 1, "description": "Strictly increasing per parent node, starting at 1." },
        "resultPath": { "type": "string", "minLength": 1 }
      }
    }
  }
}
