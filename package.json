{
  "name": "@nourhelmi/pi-meta-harness",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "bin": {
    "advisor-eval": "./scripts/advisor-eval.mjs"
  },
  "description": "Portable, reproducible Pi advisor and Herdr setup",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nourhelmi/pi-meta-harness.git"
  },
  "homepage": "https://github.com/nourhelmi/pi-meta-harness",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "advisor",
    "herdr"
  ],
  "files": [
    ".env.example",
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "config/",
    "docs/",
    "evals/cases/",
    "evals/harbor/",
    "evals/baselines/",
    "evals/prospective/",
    "extensions/",
    "herdr/",
    "scripts/",
    "skills/",
    "third-party/"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "bootstrap": "bash scripts/bootstrap.sh",
    "ui": "node scripts/advisor-ui/server.mjs",
    "plan": "node scripts/meta-harness.mjs plan",
    "doctor": "node scripts/meta-harness.mjs doctor",
    "eval:advisor": "uvx --from harbor==0.16.1 harbor run --path evals/harbor --agent nop --jobs-dir evals/local/harbor-jobs --yes",
    "eval:advisor:prepare": "node scripts/advisor-eval.mjs harbor-task",
    "eval:advisor:smoke": "uvx --from harbor==0.16.1 harbor run --path evals/harbor --agent nop --jobs-dir evals/local/harbor-jobs --disable-verification --yes",
    "eval:advisor:prospective": "node scripts/advisor-prospective.mjs run",
    "eval:advisor:prospective:prepare": "node scripts/advisor-prospective.mjs prepare",
    "eval:advisor:prospective:verify": "node scripts/advisor-prospective.mjs verify",
    "eval:advisor:prospective:list": "node scripts/advisor-prospective-manage.mjs list",
    "eval:advisor:prospective:compare": "node scripts/advisor-prospective-manage.mjs compare",
    "eval:advisor:prospective:baseline": "node scripts/advisor-prospective-manage.mjs baseline",
    "eval:advisor:prospective:suite": "node scripts/advisor-prospective-manage.mjs suite",
    "eval:advisor:prospective:view": "node scripts/advisor-eval-dashboard/server.mjs",
    "test:harness": "node --test tests/*.test.mjs",
    "test:extensions": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:harness && npm run test:extensions",
    "check": "npm test"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@earendil-works/pi-tui": "0.84.3",
    "tsx": "4.23.12",
    "typebox": "1.3.12",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "cytoscape": "^3.34.2"
  }
}
